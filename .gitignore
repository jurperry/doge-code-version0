# ---- 依赖 ----
node_modules/
**/node_modules/

# ---- 构建产物 ----
dist/
build/
out/
*.tsbuildinfo

# ---- Bun ----
.bun/
*.lockb
# npm 锁文件（本项目用 bun 管理依赖，不提交）
package-lock.json

# ---- 运行时 / 本地配置（不入库）----
.env
.env.*
!.env.example
config.env
*.local

# Claude Code / 本会话本地状态
.claude/

# Doge 项目级本地设置（运行时生成，不入库）
.doge/

# Playwright MCP 运行时缓存（console 日志 / page 快照）
.playwright-mcp/

# ---- 调试日志 ----
debug/
*.debug.log
debug-*.txt

# ---- IDE / 编辑器 ----
.idea/
.vscode/
*.swp
*.swo
*~

# ---- 操作系统 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- 打包 / 临时 ----
*.tgz
*.tar.gz
*.log
.cache/
coverage/

# ---- Playwright MCP 缓存 / npm 锁文件 ----
# .playwright-mcp/ 为 Playwright MCP 运行时日志/页面快照缓存
# package-lock.json 为 npm 副产物(项目使用 bun.lock 作为锁文件)
.playwright-mcp/
package-lock.json
